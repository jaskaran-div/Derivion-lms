# Database
DATABASE_URL=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
APP_URL=http://localhost:3000

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_PATH=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CONFIG_STANDARD=config_TniERfRtPJaKjZ
RAZORPAY_CONFIG_EMI=config_TniFJkBEcjWygb

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=Derivion LMS

# App
APP_NAME=Derivion LMS
ADMIN_EMAIL=admin@derivion.com

# Optional: Redis for caching and shared rate limits (falls back to memory)
REDIS_URL=redis://127.0.0.1:6379
# Optional: session-mode Postgres URL for prisma migrate when DATABASE_URL is a pooler
DIRECT_URL=
# Optional: error monitoring
SENTRY_DSN=
# Optional: database backups (npm run db:backup; needs pg_dump on PATH)
BACKUP_KEEP=14
BACKUP_TO_S3=false
# Optional: log verbosity (error|warn|info|debug)
LOG_LEVEL=
