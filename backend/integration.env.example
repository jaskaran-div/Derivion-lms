# Add these to the LMS .env to enable the Operations integration. Values are never committed.
# ---- Operations integration (inert until OPERATIONS_API_URL and both secrets are set) ----
# Base URL of the Operations API, e.g. https://operations.derivion.in
OPERATIONS_API_URL=
# Base URL used in learners' onboarding links (defaults to OPERATIONS_API_URL)
OPERATIONS_PUBLIC_URL=
# 32+ random chars, the SAME value as LMS_INTEGRATION_SECRET in the Operations .env
LMS_INTEGRATION_SECRET=
LMS_INTEGRATION_SECRET_PREVIOUS=
# 32+ random chars, LMS only (never shared). Derives the onboarding link tokens.
ONBOARDING_TOKEN_SECRET=
ONBOARDING_TOKEN_TTL_DAYS=30
# Invoice header. Nothing is invented: tax lines print only when these are set. Use | between address lines.
INVOICE_COMPANY_NAME=
INVOICE_COMPANY_ADDRESS=
INVOICE_TAX_ID=
INVOICE_TAX_LABEL=GSTIN
INVOICE_TAX_RATE=
# Email delivery (worker)
EMAIL_PROVIDER=smtp
EMAIL_MAX_ATTEMPTS=5
WORKER_INTERVAL_MS=5000

# ---- Queue transport (optional; default is the database-polling worker) ----
QUEUE_DRIVER=db
# Used only when QUEUE_DRIVER=sqs (see deploy/aws/README.md). Credentials come from the instance IAM role.
AWS_REGION=
SQS_EVENTS_QUEUE_URL=
SQS_EMAIL_QUEUE_URL=
SQS_DLQ_URL=
# Historical backfill of EXISTING learners/enrollments: OFF by default. Leave off for the first deployment; switch to on
# deliberately after the connection has been verified with a few test learners. New verifications/enrollments sync regardless.
LEARNER_SYNC_SWEEP=off
# Onboarding reminders (off when empty): days after purchase, e.g. 3,7
ONBOARDING_REMINDER_DAYS=
