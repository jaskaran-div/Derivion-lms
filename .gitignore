# Local environment files; only checked-in templates are allowed
**/.env*
!**/.env.example

# Dependencies and generated output
**/node_modules/
**/.next/
**/coverage/
**/dist/
**/build/
**/*.tsbuildinfo
**/next-env.d.ts

# Saved frontend Git metadata
/frontend/.git-backup/

# Local uploads are ephemeral on Render; use S3 for persistent storage
/backend/uploads/

# Database dumps (may contain personal data)
/backend/backups/

# Logs and local keys
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/*.pem
